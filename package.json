{
  "name": "nostr",
  "version": "1.9.0",
  "type": "module",
  "engines": {
    "node": ">=24",
    "npm": ">=11.15.0"
  },
  "description": "Send EVENT to Nostr",
  "main": "src/index.js",
  "scripts": {
    "lint": "eslint .",
    "package": "rimraf ./dist && rollup --config rollup.config.mjs",
    "test": "node --test --test-isolation=none",
    "test:coverage": "node --test --test-isolation=none --experimental-test-coverage --test-coverage-include=\"src/**/*.js\" --test-coverage-exclude=\"src/index.js\" --test-coverage-exclude=\"src/*.test.js\" --test-reporter=spec",
    "all": "npm run lint && npm run package && npm run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snow-actions/nostr.git"
  },
  "keywords": [
    "GitHub",
    "Actions",
    "JavaScript"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/snow-actions/nostr/issues"
  },
  "homepage": "https://github.com/snow-actions/nostr#readme",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@noble/hashes": "^2.3.0",
    "js-yaml": "^5.2.3",
    "nostr-tools": "^2.24.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "eslint": "^9.39.2",
    "rimraf": "^6.1.3",
    "rollup": "^4.57.1"
  }
}
