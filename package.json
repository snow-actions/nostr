{
  "name": "nostr",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24",
    "npm": ">=11.15.0"
  },
  "description": "Send EVENT to Nostr",
  "scripts": {
    "lint": "eslint .",
    "package": "rimraf ./dist && rollup --config rollup.config.mjs",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**/*.js\" --test-coverage-exclude=\"src/index.js\" --test-coverage-exclude=\"src/*.test.js\" --test-reporter=spec",
    "all": "npm run lint && npm run package && npm run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snow-actions/nostr.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/snow-actions/nostr/issues"
  },
  "homepage": "https://github.com/snow-actions/nostr#readme",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@noble/hashes": "^2.3.0",
    "js-yaml": "^5.3.0",
    "nostr-tools": "^2.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "eslint": "^10.8.1",
    "globals": "^14.0.0",
    "rimraf": "^6.1.3",
    "rollup": "^4.57.1"
  }
}
