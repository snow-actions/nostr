{
  "name": "nostr",
  "version": "1.9.0",
  "type": "module",
  "description": "Send EVENT to Nostr",
  "main": "index.js",
  "scripts": {
    "lint": "eslint .",
    "package": "npx rimraf ./dist && npx rollup --config rollup.config.mjs",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage --collectCoverageFrom=nostr.js --coverageReporters=text --coverageReporters=json-summary",
    "all": "npm run lint && npm run package && npm run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snow-actions/nostr.git"
  },
  "keywords": [
    "GitHub",
    "Actions",
    "JavaScript"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/snow-actions/nostr/issues"
  },
  "homepage": "https://github.com/snow-actions/nostr#readme",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@noble/hashes": "^2.3.0",
    "js-yaml": "^5.2.3",
    "nostr-tools": "^2.24.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@jest/globals": "^30.3.0",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "eslint": "^9.39.2",
    "jest": "^30.3.0",
    "rimraf": "^6.1.3",
    "rollup": "^4.57.1"
  }
}
